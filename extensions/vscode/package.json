        "category": "Agorix Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agorixStudio.exportAgorix",
        "title": "Export Portable .agorix Project",
        "category": "Agorix Studio",
        "icon": "$(export)"
      },
      {
        "command": "agorixStudio.signIn",
        "title": "Sign In With Account Token",
        "category": "Agorix Studio",
        "icon": "$(account)"
      },
      {
        "command": "agorixStudio.signOut",
        "title": "Sign Out",
        "category": "Agorix Studio",
        "icon": "$(sign-out)"
      },
      {
        "command": "agorixStudio.listRemoteProjects",
        "title": "List Account Projects",
        "category": "Agorix Studio",
        "icon": "$(cloud)"
      },
      {
        "command": "agorixStudio.openRemoteProject",
        "title": "Open Account Project",
        "category": "Agorix Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agorixStudio.saveRemoteProject",
        "title": "Save Account Project",

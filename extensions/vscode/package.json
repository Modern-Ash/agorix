    "menus": {
      "view/item/context": [
        {
          "command": "agorixStudio.openProject",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.exportAgorix",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.saveRemoteProject",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.showEvidence",
          "when": "viewItem == agorixProgress",
          "group": "inline"
        },
        {
          "command": "agorixStudio.suggestRepeat",
          "when": "viewItem == agorixCompanion",
          "group": "inline"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "viewItem == agorixCompanion || viewItem == agorixCompanionTurn",
          "group": "inline"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "viewItem == agorixCompanion || viewItem == agorixCompanionTurn",
          "group": "inline"
        },
        {
          "command": "agorixStudio.revealProposalAffectedNode",
          "when": "viewItem == agorixProposal",
          "group": "inline"
        },
        {
          "command": "agorixStudio.selectExecutionStep",
          "when": "viewItem == agorixRuntimeFact",
          "group": "inline"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "viewItem == agorixDeveloperTask",
          "group": "inline"
        },
        {
          "command": "agorixStudio.openScm",
          "when": "viewItem == agorixDeveloperTask",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "agorixStudio.createProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openRemoteProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.exportAgorix",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.saveRemoteProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openWorkbench",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionChallenge",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionReflect",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionBuild",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.undoProposal",
          "when": "view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.redoProposal",
          "when": "view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.runChecks",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openScm",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.run",
          "when": "(view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != running",
          "group": "navigation@1"
        },
        {
          "command": "agorixStudio.step",
          "when": "(view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != completed",
          "group": "navigation@2"
        },
        {
          "command": "agorixStudio.stop",
          "when": "(view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus == running",
          "group": "navigation@3"
        },
        {
          "command": "agorixStudio.reset",
          "when": "(view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != idle",
          "group": "navigation@4"
        },
        {
          "command": "agorixStudio.openWorldPreview",
          "when": "view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "agorixStudio.run",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != running",
          "group": "navigation@1"
        },
        {
          "command": "agorixStudio.step",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != completed",
          "group": "navigation@2"
        },
        {
          "command": "agorixStudio.stop",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus == running",
          "group": "navigation@3"
        },
        {
          "command": "agorixStudio.reset",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != idle",
          "group": "navigation@4"
        },
        {
          "command": "agorixStudio.switchProjection",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@5"
        },
        {
          "command": "agorixStudio.openWorldPreview",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@6"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@7"
        },
        {
          "command": "agorixStudio.revealCanonicalNode",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@1"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@2"
        },
        {
          "command": "agorixStudio.undoProposal",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@3"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agorixStudio.projects",
        "contents": "Agorix Studio\n\nStart coding with Agorix.\n\n[Create New Project](command:agorixStudio.createProject)\n[Open .agorix Project](command:agorixStudio.openProject)\n[Open Account Project](command:agorixStudio.openRemoteProject)\n\nYou can work locally without an account.\n\nAgorix can suggest, explain and debug from your program and runtime evidence. Changes are never applied without your approval.",
        "when": "!agorixStudio.hasProject"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json && node scripts/bundle.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node test/integration/run.cjs",
    "test:vsix": "node test/integration/vsix.cjs",
    "package": "pnpm build && vsce package --no-dependencies --out dist/agorix-studio.vsix"
  },
  "dependencies": {
    "@agorix/agent-workflow": "workspace:*",
    "@agorix/agorix-code": "workspace:*",
    "@agorix/block-editor": "workspace:*",
    "@agorix/code-generator": "workspace:*",
    "@agorix/curriculum": "workspace:*",
    "@agorix/interaction-core": "workspace:*",
    "@agorix/language-projection": "workspace:*",
    "@agorix/learning-decision-plane": "workspace:*",
    "@agorix/persistence": "workspace:*",
    "@agorix/platform-contract": "workspace:*",
    "@agorix/program-model": "workspace:*",
    "@agorix/proposals": "workspace:*",
    "@agorix/provider-runtime": "workspace:*",
    "@agorix/python-projection": "workspace:*",
    "@agorix/runtime": "workspace:*",
    "@agorix/stage": "workspace:*",
    "@agorix/studio-protocol": "workspace:*",
    "@agorix/studio-ui": "workspace:*",
    "@agorix/tutor-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}

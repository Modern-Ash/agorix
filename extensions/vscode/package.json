        "icon": "$(bug)"
      },
      {
        "command": "agorixStudio.companionReflect",
        "title": "Reflect On Run",
        "category": "Agorix Studio",
        "icon": "$(mirror)"
      },
      {
        "command": "agorixStudio.companionBuild",
        "title": "Build Proposal",
        "category": "Agorix Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "agorixStudio.suggestFirstStep",
        "title": "Suggest First Step",
        "category": "Agorix Studio",
        "icon": "$(lightbulb)"
      },
      {
        "command": "agorixStudio.applyProposal",
        "title": "Apply Proposal",
        "category": "Agorix Studio",
        "icon": "$(check)"
      },
      {
        "command": "agorixStudio.rejectProposal",
        "title": "Reject Proposal",
        "category": "Agorix Studio",
        "icon": "$(close)"
      },
      {
        "command": "agorixStudio.revealProposalAffectedNode",
        "title": "Reveal Proposal Affected Node",
        "category": "Agorix Studio",

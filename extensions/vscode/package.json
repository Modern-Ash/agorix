{
  "name": "agorix-studio",
  "displayName": "Agorix Studio",
  "description": "VS Code learning and creation surface for Agorix projects.",
  "publisher": "modern-ash",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "agorix",
    "learning",
    "programming",
    "education",
    "projection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Modern-Ash/agorix.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/Modern-Ash/agorix/tree/main/extensions/vscode#readme",
  "bugs": {
    "url": "https://github.com/Modern-Ash/agorix/issues"
  },
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onCommand:agorixStudio.createProject",
    "onCommand:agorixStudio.openProject",
    "onCommand:agorixStudio.exportAgorix",
    "onCommand:agorixStudio.signIn",
    "onCommand:agorixStudio.signOut",
    "onCommand:agorixStudio.listRemoteProjects",
    "onCommand:agorixStudio.openRemoteProject",
    "onCommand:agorixStudio.saveRemoteProject",
    "onCommand:agorixStudio.openProjection",
    "onCommand:agorixStudio.switchProjection",
    "onCommand:agorixStudio.revealCanonicalNode",
    "onCommand:agorixStudio.openWorldPreview",
    "onCommand:agorixStudio.openWorkbench",
    "onCommand:agorixStudio.run",
    "onCommand:agorixStudio.step",
    "onCommand:agorixStudio.reset",
    "onCommand:agorixStudio.stop",
    "onCommand:agorixStudio.selectExecutionStep",
    "onCommand:agorixStudio.companionExplain",
    "onCommand:agorixStudio.companionChallenge",
    "onCommand:agorixStudio.companionDebug",
    "onCommand:agorixStudio.companionReflect",
    "onCommand:agorixStudio.companionBuild",
    "onCommand:agorixStudio.suggestFirstStep",
    "onCommand:agorixStudio.applyProposal",
    "onCommand:agorixStudio.ambientOffer",
    "onCommand:agorixStudio.rejectProposal",
    "onCommand:agorixStudio.revealProposalAffectedNode",
    "onCommand:agorixStudio.undoProposal",
    "onCommand:agorixStudio.redoProposal",
    "onCommand:agorixStudio.showEvidence",
    "onCommand:agorixStudio.validateProject",
    "onCommand:agorixStudio.runChecks",
    "onCommand:agorixStudio.showDeveloperContext",
    "onCommand:agorixStudio.openScm",
    "onCommand:agorixStudio.suggestRepeat",
    "onCommand:agorixStudio.clearAgentCredential",
    "onCommand:agorixStudio.setAgentCredential",
    "onCommand:agorixStudio.checkAgentHealth",
    "onView:agorixStudio.projects",
    "onView:agorixStudio.missions",
    "onView:agorixStudio.progress",
    "onView:agorixStudio.worlds",
    "onView:agorixStudio.inspector",
    "onView:agorixStudio.companion",
    "onView:agorixStudio.companionHistory",
    "onView:agorixStudio.developer"
  ],
  "contributes": {
    "configuration": {
      "title": "Agorix Studio",
      "properties": {
        "agorixStudio.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional Agorix project server URL. Account tokens are stored in VS Code SecretStorage, never in settings."
        },
        "agorixStudio.agent.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow Studio to ask the Learning Companion for help. Editing and running never depend on it."
        },
        "agorixStudio.agent.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Tutor API / adapter boundary endpoint (for example `http://127.0.0.1:8787`). Studio never talks to a model provider directly. Never put credentials here."
        },
        "agorixStudio.agent.remoteEndpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional remote tutor API endpoint. Ignored unless `agorixStudio.agent.allowRemote` is on. Never put credentials here."
        },
        "agorixStudio.agent.preferLocal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Try local (loopback) endpoints before remote ones."
        },
        "agorixStudio.agent.allowRemote": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Explicit opt-in to contact a non-local endpoint. Off by default. Credentials, when a deployment needs them, are stored in VS Code SecretStorage via the `Set Agent Credential` command, never in settings."
        },
        "agorixStudio.agent.healthTimeoutMs": {
          "type": "integer",
          "default": 1500,
          "minimum": 100,
          "maximum": 120000,
          "markdownDescription": "Timeout for the availability probe, in milliseconds."
        },
        "agorixStudio.agent.requestTimeoutMs": {
          "type": "integer",
          "default": 8000,
          "minimum": 100,
          "maximum": 120000,
          "markdownDescription": "Timeout for a Learning Companion request, in milliseconds."
        },
        "agorixStudio.agent.layaEndpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional local LAYA decision endpoint. Studio calls `POST /decideMany` only for cheap proactive veto decisions. Remote endpoints require `agorixStudio.agent.allowRemote`."
        },
        "agorixStudio.agent.proposalBudgetRequests": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 1000,
          "markdownDescription": "Maximum AI-backed suggestions per Studio session. When the limit is reached Studio keeps offering built-in suggestions; editing and running are unaffected."
        },
        "agorixStudio.agent.ambientBudgetRequests": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 1000,
          "markdownDescription": "Maximum ambient proactive offers per Studio session. Editing, running and explicit Companion commands are unaffected."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agorixStudio",
          "title": "Agorix Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agorixStudio": [
        {
          "id": "agorixStudio.projects",
          "name": "Projects",
          "icon": "$(folder)"
        },
        {
          "id": "agorixStudio.missions",
          "name": "Missions",
          "when": "agorixStudio.hasProject",
          "icon": "$(target)"
        },
        {
          "id": "agorixStudio.progress",
          "name": "Progress",
          "when": "agorixStudio.hasProject",
          "icon": "$(graph)"
        },
        {
          "id": "agorixStudio.worlds",
          "name": "Worlds",
          "when": "agorixStudio.hasProject",
          "icon": "$(globe)"
        },
        {
          "id": "agorixStudio.inspector",
          "name": "Inspector",
          "when": "agorixStudio.hasProject",
          "icon": "$(debug-alt)"
        },
        {
          "id": "agorixStudio.companion",
          "name": "Learning Companion",
          "when": "agorixStudio.hasProject",
          "icon": "$(sparkle)"
        },
        {
          "id": "agorixStudio.companionHistory",
          "name": "Companion Responses",
          "when": "agorixStudio.hasProject",
          "icon": "$(history)"
        },
        {
          "id": "agorixStudio.developer",
          "name": "Developer",
          "when": "agorixStudio.hasProject",
          "icon": "$(tools)"
        }
      ]
    },
    "commands": [
      {
        "command": "agorixStudio.createProject",
        "title": "Create New Project",
        "category": "Agorix Studio",
        "icon": "$(new-file)"
      },
      {

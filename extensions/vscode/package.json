      },
      {
        "command": "agorixStudio.redoProposal",
        "title": "Redo Proposal",
        "category": "Agorix Studio",
        "icon": "$(redo)"
      },
      {
        "command": "agorixStudio.showEvidence",
        "title": "Show Execution Evidence",
        "category": "Agorix Studio",
        "icon": "$(output)"
      },
      {
        "command": "agorixStudio.validateProject",
        "title": "Validate Project",

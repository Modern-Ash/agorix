      },
      {
        "command": "agorixStudio.companionChallenge",
        "title": "Challenge Prediction",
        "category": "Agorix Studio",
        "icon": "$(question)"
      },
      {
        "command": "agorixStudio.companionDebug",
        "title": "Debug With Evidence",

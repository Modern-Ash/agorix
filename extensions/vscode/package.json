{
  "name": "agorix-studio",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "modern-ash",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "agorix",
    "learning",
    "programming",
    "education",
    "projection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Modern-Ash/agorix.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/Modern-Ash/agorix/tree/main/extensions/vscode#readme",
  "bugs": {
    "url": "https://github.com/Modern-Ash/agorix/issues"
  },
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onCommand:agorixStudio.createProject",
    "onCommand:agorixStudio.openProject",
    "onCommand:agorixStudio.exportAgorix",
    "onCommand:agorixStudio.exportEducatorEvidence",
    "onCommand:agorixStudio.signIn",
    "onCommand:agorixStudio.signOut",
    "onCommand:agorixStudio.listRemoteProjects",
    "onCommand:agorixStudio.openRemoteProject",
    "onCommand:agorixStudio.saveRemoteProject",
    "onCommand:agorixStudio.openProjection",
    "onCommand:agorixStudio.switchProjection",
    "onCommand:agorixStudio.revealCanonicalNode",
    "onCommand:agorixStudio.openWorldPreview",
    "onCommand:agorixStudio.openWorkbench",
    "onCommand:agorixStudio.run",
    "onCommand:agorixStudio.step",
    "onCommand:agorixStudio.reset",
    "onCommand:agorixStudio.stop",
    "onCommand:agorixStudio.selectExecutionStep",
    "onCommand:agorixStudio.companionExplain",
    "onCommand:agorixStudio.companionChallenge",
    "onCommand:agorixStudio.companionDebug",
    "onCommand:agorixStudio.companionReflect",
    "onCommand:agorixStudio.companionBuild",
    "onCommand:agorixStudio.suggestFirstStep",
    "onCommand:agorixStudio.applyProposal",
    "onCommand:agorixStudio.ambientOffer",
    "onCommand:agorixStudio.rejectProposal",
    "onCommand:agorixStudio.revealProposalAffectedNode",
    "onCommand:agorixStudio.undoProposal",
    "onCommand:agorixStudio.redoProposal",
    "onCommand:agorixStudio.showEvidence",
    "onCommand:agorixStudio.validateProject",
    "onCommand:agorixStudio.runChecks",
    "onCommand:agorixStudio.showDeveloperContext",
    "onCommand:agorixStudio.openScm",
    "onCommand:agorixStudio.suggestRepeat",
    "onCommand:agorixStudio.clearAgentCredential",
    "onCommand:agorixStudio.setAgentCredential",
    "onCommand:agorixStudio.checkAgentHealth",
    "onView:agorixStudio.projects",
    "onView:agorixStudio.missions",
    "onView:agorixStudio.progress",
    "onView:agorixStudio.worlds",
    "onView:agorixStudio.inspector",
    "onView:agorixStudio.companion",
    "onView:agorixStudio.companionHistory",
    "onView:agorixStudio.developer"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "agorixStudio.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.serverUrl%"
        },
        "agorixStudio.agent.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.agent.enabled%"
        },
        "agorixStudio.agent.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.agent.endpoint%"
        },
        "agorixStudio.agent.remoteEndpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.agent.remoteEndpoint%"
        },
        "agorixStudio.agent.preferLocal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.agent.preferLocal%"
        },
        "agorixStudio.agent.allowRemote": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.agent.allowRemote%"
        },
        "agorixStudio.agent.healthTimeoutMs": {
          "type": "integer",
          "default": 1500,
          "minimum": 100,
          "maximum": 120000,
          "markdownDescription": "%config.agent.healthTimeoutMs%"
        },
        "agorixStudio.agent.requestTimeoutMs": {
          "type": "integer",
          "default": 8000,
          "minimum": 100,
          "maximum": 120000,
          "markdownDescription": "%config.agent.requestTimeoutMs%"
        },
        "agorixStudio.agent.layaEndpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.agent.layaEndpoint%"
        },
        "agorixStudio.agent.proposalBudgetRequests": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 1000,
          "markdownDescription": "%config.agent.proposalBudgetRequests%"
        },
        "agorixStudio.agent.ambientBudgetRequests": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 1000,
          "markdownDescription": "%config.agent.ambientBudgetRequests%"
        },
        "agorixStudio.workbench.density": {
          "type": "string",
          "enum": [
            "auto",
            "comfortable",
            "compact"
          ],
          "default": "auto",
          "markdownDescription": "%config.workbench.density%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agorixStudio",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agorixStudio": [
        {
          "id": "agorixStudio.projects",
          "name": "%view.projects.name%",
          "icon": "$(folder)"
        },
        {
          "id": "agorixStudio.missions",
          "name": "%view.missions.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(target)"
        },
        {
          "id": "agorixStudio.progress",
          "name": "%view.progress.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(graph)"
        },
        {
          "id": "agorixStudio.worlds",
          "name": "%view.worlds.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(globe)"
        },
        {
          "id": "agorixStudio.inspector",
          "name": "%view.inspector.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(debug-alt)"
        },
        {
          "id": "agorixStudio.companion",
          "name": "%view.companion.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(sparkle)"
        },
        {
          "id": "agorixStudio.companionHistory",
          "name": "%view.companionHistory.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(history)"
        },
        {
          "id": "agorixStudio.developer",
          "name": "%view.developer.name%",
          "when": "agorixStudio.hasProject",
          "icon": "$(tools)"
        }
      ]
    },
    "commands": [
      {
        "command": "agorixStudio.createProject",
        "title": "%command.createProject.title%",
        "category": "%category%",
        "icon": "$(new-file)"
      },
      {
        "command": "agorixStudio.openProject",
        "title": "%command.openProject.title%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agorixStudio.exportAgorix",
        "title": "%command.exportAgorix.title%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "agorixStudio.exportEducatorEvidence",
        "title": "%command.exportEducatorEvidence.title%",
        "category": "%category%",
        "icon": "$(notebook)"
      },
      {
        "command": "agorixStudio.signIn",
        "title": "%command.signIn.title%",
        "category": "%category%",
        "icon": "$(account)"
      },
      {
        "command": "agorixStudio.signOut",
        "title": "%command.signOut.title%",
        "category": "%category%",
        "icon": "$(sign-out)"
      },
      {
        "command": "agorixStudio.listRemoteProjects",
        "title": "%command.listRemoteProjects.title%",
        "category": "%category%",
        "icon": "$(cloud)"
      },
      {
        "command": "agorixStudio.openRemoteProject",
        "title": "%command.openRemoteProject.title%",
        "category": "%category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agorixStudio.saveRemoteProject",
        "title": "%command.saveRemoteProject.title%",
        "category": "%category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agorixStudio.openProjection",
        "title": "%command.openProjection.title%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agorixStudio.switchProjection",
        "title": "%command.switchProjection.title%",
        "category": "%category%",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "agorixStudio.revealCanonicalNode",
        "title": "%command.revealCanonicalNode.title%",
        "category": "%category%",
        "icon": "$(target)"
      },
      {
        "command": "agorixStudio.openWorldPreview",
        "title": "%command.openWorldPreview.title%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "agorixStudio.openWorkbench",
        "title": "%command.openWorkbench.title%",
        "category": "%category%",
        "icon": "$(layout)"
      },
      {
        "command": "agorixStudio.run",
        "title": "%command.run.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "agorixStudio.step",
        "title": "%command.step.title%",
        "category": "%category%",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "agorixStudio.reset",
        "title": "%command.reset.title%",
        "category": "%category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agorixStudio.stop",
        "title": "%command.stop.title%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agorixStudio.selectExecutionStep",
        "title": "%command.selectExecutionStep.title%",
        "category": "%category%",
        "icon": "$(debug-stackframe-dot)"
      },
      {
        "command": "agorixStudio.companionExplain",
        "title": "%command.companionExplain.title%",
        "category": "%category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agorixStudio.companionChallenge",
        "title": "%command.companionChallenge.title%",
        "category": "%category%",
        "icon": "$(question)"
      },
      {
        "command": "agorixStudio.companionDebug",
        "title": "%command.companionDebug.title%",
        "category": "%category%",
        "icon": "$(bug)"
      },
      {
        "command": "agorixStudio.companionReflect",
        "title": "%command.companionReflect.title%",
        "category": "%category%",
        "icon": "$(mirror)"
      },
      {
        "command": "agorixStudio.companionBuild",
        "title": "%command.companionBuild.title%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "agorixStudio.suggestFirstStep",
        "title": "%command.suggestFirstStep.title%",
        "category": "%category%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "agorixStudio.applyProposal",
        "title": "%command.applyProposal.title%",
        "category": "%category%",
        "icon": "$(check)"
      },
      {
        "command": "agorixStudio.rejectProposal",
        "title": "%command.rejectProposal.title%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "agorixStudio.revealProposalAffectedNode",
        "title": "%command.revealProposalAffectedNode.title%",
        "category": "%category%",
        "icon": "$(target)"
      },
      {
        "command": "agorixStudio.undoProposal",
        "title": "%command.undoProposal.title%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "agorixStudio.redoProposal",
        "title": "%command.redoProposal.title%",
        "category": "%category%",
        "icon": "$(redo)"
      },
      {
        "command": "agorixStudio.showEvidence",
        "title": "%command.showEvidence.title%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "agorixStudio.validateProject",
        "title": "%command.validateProject.title%",
        "category": "%category%",
        "icon": "$(check-all)"
      },
      {
        "command": "agorixStudio.runChecks",
        "title": "%command.runChecks.title%",
        "category": "%category%",
        "icon": "$(checklist)"
      },
      {
        "command": "agorixStudio.showDeveloperContext",
        "title": "%command.showDeveloperContext.title%",
        "category": "%category%",
        "icon": "$(symbol-key)"
      },
      {
        "command": "agorixStudio.openScm",
        "title": "%command.openScm.title%",
        "category": "%category%",
        "icon": "$(source-control)"
      },
      {
        "command": "agorixStudio.suggestRepeat",
        "title": "%command.suggestRepeat.title%",
        "category": "%category%",
        "icon": "$(sync)"
      },
      {
        "command": "agorixStudio.ambientOffer",
        "title": "%command.ambientOffer.title%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "agorixStudio.checkAgentHealth",
        "title": "%command.checkAgentHealth.title%",
        "category": "%category%",
        "icon": "$(heart)"
      },
      {
        "command": "agorixStudio.setAgentCredential",
        "title": "%command.setAgentCredential.title%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "agorixStudio.clearAgentCredential",
        "title": "%command.clearAgentCredential.title%",
        "category": "%category%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "agorixStudio.openProject",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.exportAgorix",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.exportEducatorEvidence",
          "when": "viewItem == agorixProgress",
          "group": "inline"
        },
        {
          "command": "agorixStudio.saveRemoteProject",
          "when": "viewItem == agorixProject",
          "group": "inline"
        },
        {
          "command": "agorixStudio.showEvidence",
          "when": "viewItem == agorixProgress",
          "group": "inline"
        },
        {
          "command": "agorixStudio.suggestRepeat",
          "when": "viewItem == agorixCompanion",
          "group": "inline"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "viewItem == agorixCompanion || viewItem == agorixCompanionTurn",
          "group": "inline"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "viewItem == agorixCompanion || viewItem == agorixCompanionTurn",
          "group": "inline"
        },
        {
          "command": "agorixStudio.revealProposalAffectedNode",
          "when": "viewItem == agorixProposal",
          "group": "inline"
        },
        {
          "command": "agorixStudio.selectExecutionStep",
          "when": "viewItem == agorixRuntimeFact",
          "group": "inline"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "viewItem == agorixDeveloperTask",
          "group": "inline"
        },
        {
          "command": "agorixStudio.openScm",
          "when": "viewItem == agorixDeveloperTask",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "agorixStudio.createProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openRemoteProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.exportAgorix",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.exportEducatorEvidence",
          "when": "view == agorixStudio.progress",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.saveRemoteProject",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openWorkbench",
          "when": "view == agorixStudio.projects",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionChallenge",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionReflect",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.companionBuild",
          "when": "view == agorixStudio.companion || view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.undoProposal",
          "when": "view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.redoProposal",
          "when": "view == agorixStudio.companionHistory",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.runChecks",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.openScm",
          "when": "view == agorixStudio.developer",
          "group": "navigation"
        },
        {
          "command": "agorixStudio.run",
          "when": "(view == agorixStudio.projects || view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != running",
          "group": "navigation@1"
        },
        {
          "command": "agorixStudio.step",
          "when": "(view == agorixStudio.projects || view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != completed",
          "group": "navigation@2"
        },
        {
          "command": "agorixStudio.stop",
          "when": "(view == agorixStudio.projects || view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus == running",
          "group": "navigation@3"
        },
        {
          "command": "agorixStudio.reset",
          "when": "(view == agorixStudio.projects || view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions) && agorixStudio.executionStatus != idle",
          "group": "navigation@4"
        },
        {
          "command": "agorixStudio.openWorldPreview",
          "when": "view == agorixStudio.projects || view == agorixStudio.inspector || view == agorixStudio.progress || view == agorixStudio.worlds || view == agorixStudio.missions",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "agorixStudio.run",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != running",
          "group": "navigation@1"
        },
        {
          "command": "agorixStudio.step",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != completed",
          "group": "navigation@2"
        },
        {
          "command": "agorixStudio.stop",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus == running",
          "group": "navigation@3"
        },
        {
          "command": "agorixStudio.reset",
          "when": "resourceScheme == agorix-studio && agorixStudio.executionStatus != idle",
          "group": "navigation@4"
        },
        {
          "command": "agorixStudio.switchProjection",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@5"
        },
        {
          "command": "agorixStudio.openWorldPreview",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@6"
        },
        {
          "command": "agorixStudio.companionExplain",
          "when": "resourceScheme == agorix-studio",
          "group": "navigation@7"
        },
        {
          "command": "agorixStudio.revealCanonicalNode",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@1"
        },
        {
          "command": "agorixStudio.companionDebug",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@2"
        },
        {
          "command": "agorixStudio.undoProposal",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@3"
        },
        {
          "command": "agorixStudio.validateProject",
          "when": "resourceScheme == agorix-studio",
          "group": "1_studio@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agorixStudio.projects",
        "contents": "%welcome.projects%",
        "when": "!agorixStudio.hasProject"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json && node scripts/bundle.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node test/integration/run.cjs",
    "test:vsix": "node test/integration/vsix.cjs",
    "package": "pnpm build && vsce package --no-dependencies --out dist/agorix-studio.vsix",
    "publish:open-vsx": "pnpm package && npx --yes ovsx publish dist/agorix-studio.vsix"
  },
  "dependencies": {
    "@agorix/agent-workflow": "workspace:*",
    "@agorix/agorix-code": "workspace:*",
    "@agorix/block-editor": "workspace:*",
    "@agorix/code-generator": "workspace:*",
    "@agorix/curriculum": "workspace:*",
    "@agorix/interaction-core": "workspace:*",
    "@agorix/language-projection": "workspace:*",
    "@agorix/learning-decision-plane": "workspace:*",
    "@agorix/learning-evidence": "workspace:*",
    "@agorix/persistence": "workspace:*",
    "@agorix/platform-contract": "workspace:*",
    "@agorix/program-model": "workspace:*",
    "@agorix/proposals": "workspace:*",
    "@agorix/provider-runtime": "workspace:*",
    "@agorix/python-projection": "workspace:*",
    "@agorix/runtime": "workspace:*",
    "@agorix/stage": "workspace:*",
    "@agorix/studio-protocol": "workspace:*",
    "@agorix/studio-ui": "workspace:*",
    "@agorix/tutor-contract": "workspace:*"

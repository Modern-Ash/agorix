{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ori v1 trace-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ori/trace-evidence/v1"
    },
    "source": {
      "const": "host-runtime"
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "description"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ori v1 Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "learningStage",
    "capabilities",
    "grants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ori/context/v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "learningStage": {
      "enum": [
        "explore",
        "connect",
        "create",
        "critique"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "grants": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "hintsUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  }
}

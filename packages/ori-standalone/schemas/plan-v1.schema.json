{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ori v1 plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ori/plan/v1"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}

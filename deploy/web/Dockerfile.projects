# Durable project API. Activated only with the explicit `accounts` Compose profile.
FROM node:22.23.2-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile --filter @agorix/server...
RUN pnpm --filter @agorix/server... build

FROM node:22.23.2-alpine
WORKDIR /app
COPY --from=build /repo/apps/server/dist ./dist
CMD ["node", "dist/main.mjs"]

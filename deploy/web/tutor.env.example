# Optional host-only overrides for ~/.config/agorix/tutor.env (systemd user service).
# Codex is tried first; OpenCode is used when Codex is absent. Their logins stay on the host.
AGORIX_ORI_PROVIDER=auto
AGORIX_ORI_TIMEOUT_MS=4000
# AGORIX_ORI_CODEX_BIN=/absolute/path/to/codex
# AGORIX_ORI_OPENCODE_BIN=/absolute/path/to/opencode

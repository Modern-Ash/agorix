# Optional host-only overrides for ~/.config/agorix/tutor.env (systemd user service).
# Codex is tried first; OpenCode is used when Codex is absent. Their logins stay on the host.
AGORIX_ORI_PROVIDER=auto
AGORIX_ORI_TIMEOUT_MS=7000
# MIG-04 private pilot: keep disabled until PostgreSQL cutover, account verification,
# one project allowlist entry, a real Ori checkout and successful rollback drill.
# AGORIX_ORI_MIG04_PILOT=1
# AGORIX_ORI_DEPLOYMENT_ID=private-pilot
# AGORIX_ALLOWED_ADULT_EMAIL=adult@example.com
# AGORIX_TUTOR_POSTGRES_URL=postgresql://agorix:REPLACE_WITH_SECRET@127.0.0.1:5433/agorix
# ORI_REPO_PATH=/absolute/path/to/ori
# AGORIX_ORI_CODEX_MODEL=gpt-6-luna
# AGORIX_ORI_CODEX_BIN=/absolute/path/to/codex
# AGORIX_ORI_OPENCODE_BIN=/absolute/path/to/opencode
# Private project review only; requires an Ori checkout with host proposal routing.
# Disabled by default. These endpoints must be loopback HTTP and tool-free.
# AGORIX_ORI_REVIEW_PROVIDER=auto
# AGORIX_ORI_REVIEW_MODEL_TIMEOUT_MS=1500
# AGORIX_ORI_REVIEW_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# AGORIX_ORI_REVIEW_OLLAMA_MODEL=qwen2.5:3b
# AGORIX_ORI_REVIEW_COMPATIBLE_ENDPOINT=http://127.0.0.1:4096
# AGORIX_ORI_REVIEW_COMPATIBLE_MODEL=local-educational
# Optional private CLI route after Ori host-proposal CLI support is installed.
# AGORIX_ORI_REVIEW_PROVIDER=cli-auto
# AGORIX_ORI_REVIEW_MODEL_TIMEOUT_MS=4500
# AGORIX_ORI_REVIEW_CODEX_BIN=/absolute/path/to/codex
# AGORIX_ORI_REVIEW_OPENCODE_BIN=/absolute/path/to/opencode
# AGORIX_ORI_REVIEW_CODEX_MODEL=gpt-6-luna

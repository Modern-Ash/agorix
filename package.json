{
  "name": "agorix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@azure/msal-node": "^7.1.0",
      "source-map-js": "1.2.2",
      "vite": "^7.3.7"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "security:check": "node scripts/security-baseline.mjs",
    "verify": "pnpm install --frozen-lockfile && pnpm lint && pnpm test && pnpm build && pnpm security:check",
    "deploy:web": "bash scripts/deploy-web.sh",
    "rollback:web": "bash scripts/rollback-web.sh",
    "test:ori:interop": "node scripts/verify-ori-interop.mjs",
    "test:ori:runtime": "node scripts/verify-ori-runtime-integration.mjs",
    "test:ori:browser-live": "pnpm --filter @agorix/tutor-api build && pnpm --filter @agorix/web build && pnpm --filter @agorix/web test:e2e -- ori-live-runtime.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
